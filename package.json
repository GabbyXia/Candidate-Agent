{
  "name": "talent-atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "npm run build && node scripts/serve-pages.mjs",
    "dev:local": "node scripts/dev.mjs",
    "build:worker": "node scripts/build.mjs",
    "test": "npm run build:worker && node --test tests/*.test.mjs",
    "validate": "node --test tests/pages-build.test.mjs tests/static-ui.test.mjs",
    "validate:worker": "node scripts/validate-artifact.mjs",
    "collect:usenix": "node scripts/collect-usenix.mjs",
    "collect:networking": "node scripts/collect-networking.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
